{
  "name": "brecord",
  "productName": "BRecord",
  "version": "0.4.0",
  "description": "Lokální zápisy ze schůzek: nahrávání mikrofonu i zvuku počítače, přepis přes whisper.cpp a shrnutí přes Claude Code nebo Codex.",
  "author": {
    "name": "Michal Jašek",
    "email": "131132317+myspulin24@users.noreply.github.com",
    "url": "https://github.com/myspulin24"
  },
  "license": "MIT",
  "homepage": "https://github.com/myspulin24/brecord#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myspulin24/brecord.git"
  },
  "bugs": {
    "url": "https://github.com/myspulin24/brecord/issues"
  },
  "keywords": [
    "meeting-notes",
    "transcription",
    "whisper",
    "electron",
    "claude-code",
    "codex",
    "tray-app"
  ],
  "private": true,
  "main": "src/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "setup": "node scripts/setup.js",
    "doctor": "node src/cli.js doctor",
    "process": "node src/cli.js process",
    "resummarize": "node src/cli.js resummarize",
    "test-summary": "node src/cli.js test-summary",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.{js,mjs}\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.{js,mjs}\"",
    "e2e": "node scripts/e2e-smoke.js",
    "smoke": "node scripts/smoke.js",
    "icons": "node scripts/make-icons.js",
    "screenshots": "node scripts/screenshots.js",
    "changelog": "node scripts/changelog.mjs",
    "pack": "electron-builder --dir --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:mac": "electron-builder --mac --publish never",
    "dist:linux": "electron-builder --linux --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "globals": "^17.12.0"
  },
  "build": {
    "appId": "io.github.myspulin24.brecord",
    "productName": "BRecord",
    "copyright": "Copyright © 2026 Michal Jašek",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "LICENSE"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "myspulin24",
        "repo": "brecord",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "BRecord",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "NSMicrophoneUsageDescription": "BRecord nahrává váš mikrofon během schůzek, které sami spustíte.",
        "NSAudioCaptureUsageDescription": "BRecord nahrává zvuk ostatních účastníků schůzek, které sami spustíte."
      }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "executableName": "brecord",
      "category": "Office",
      "synopsis": "Lokální zápisy ze schůzek",
      "maintainer": "Michal Jašek <131132317+myspulin24@users.noreply.github.com>"
    }
  }
}
